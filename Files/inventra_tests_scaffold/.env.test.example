# .env.test.example
#
# Copy this to .env.test and adjust if needed:
#   cp .env.test.example .env.test
#
# .env.test should be gitignored, same as .env — it only holds throwaway
# test credentials matching docker-compose.test.yml, but keep the pattern
# consistent so real secrets never accidentally end up in either file.
#
# Loaded by config/settings_test.py, which overrides Django's DATABASES
# and REDIS_URL to point here instead of at your real dev/production
# infrastructure.

# Minimal values Django needs to boot at all (settings.py requires these
# to be set; real production values obviously differ).
DJANGO_SECRET_KEY=test-secret-key-not-for-real-use
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Must match the postgres-test service in docker-compose.test.yml
# (same DB name/user/password, port 5433 on the host).
TEST_DB_NAME=inventra_test
TEST_DB_USER=inventra_test
TEST_DB_PASSWORD=inventra_test
TEST_DB_HOST=localhost
TEST_DB_PORT=5433

# Must match the redis-test service in docker-compose.test.yml
# (port 6380 on the host). DB index 0 is fine here since redis-test is
# an entirely separate container, not a shared instance split by index.
TEST_REDIS_URL=redis://localhost:6380/0

# otp_services.py / IsInternalService don't care whether these are real
# tokens in a test environment — any fixed string works, since tests
# never talk to the actual Telegram API or a real internal service.
INTERNAL_SERVICE_TOKEN=test-internal-token
TELEGRAM_BOT_TOKEN=test-bot-token
