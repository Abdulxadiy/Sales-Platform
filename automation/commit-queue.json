{
  "repository": "Abdulxadiy/Sales-Platform",
  "remote": "https://github.com/Abdulxadiy/Sales-Platform.git",
  "default_branch": "main",
  "backup_branch": "backup/work-in-progress",
  "queue_branch": "queue/ready",
  "state_branch": "queue/progress",
  "author_name": "Abdulxadiy",
  "author_email": "241130805+Abdulxadiy@users.noreply.github.com",
  "timezone": "Asia/Tashkent",
  "paused": false,
  "validation": [
    {
      "cwd": ".",
      "argv": [
        "python3",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/automation",
        "-v"
      ]
    },
    {
      "cwd": "ilbi",
      "argv": [
        "uv",
        "sync",
        "--frozen"
      ]
    },
    {
      "cwd": "ilbi",
      "argv": [
        "uv",
        "run",
        "ruff",
        "check",
        ".",
        "--select",
        "E9,F821,F822,F823"
      ]
    },
    {
      "cwd": "ilbi",
      "argv": [
        "uv",
        "run",
        "python",
        "manage.py",
        "spectacular",
        "--settings=config.settings_test",
        "--validate",
        "--fail-on-warn",
        "--file",
        "/tmp/queue-api-schema.yml"
      ]
    },
    {
      "cwd": "ilbi",
      "argv": [
        "uv",
        "run",
        "pytest",
        "-q"
      ]
    },
    {
      "cwd": "frontend/ilbi",
      "argv": [
        "npm",
        "ci"
      ]
    },
    {
      "cwd": "frontend/ilbi",
      "argv": [
        "npm",
        "run",
        "lint",
        "--if-present"
      ]
    },
    {
      "cwd": "frontend/ilbi",
      "argv": [
        "npm",
        "test"
      ]
    },
    {
      "cwd": "frontend/ilbi",
      "argv": [
        "npm",
        "run",
        "build"
      ]
    }
  ],
  "auto_enqueue": true,
  "daily": {
    "minimum": 15,
    "target_min": 18,
    "target_max": 22,
    "maximum": 25
  }
}
